-// Keeps the game at full speed on slow phones by lowering the interpolated FPS automatically when the game logic
-// falls below 20 ticks per second. It is on by default; create the folder SOH/adaptive_off to disable it.
+// Keeps the game at full speed on slow phones. When the game logic falls below 20 ticks per second the quality goes
+// down step by step (internal resolution first, then the interpolated FPS) and goes back up when there is room.
+// It is on by default. Create the folder SOH/adaptive_off to disable it, or SOH/adaptive_keep_res to leave the
+// resolution alone and only lower the FPS.
 bool AdaptiveEnabled() {
     static const bool enabled = !PerfLog::FolderExists("adaptive_off");
     return enabled;
 }
+
+bool AdaptiveChangesResolution() {
+    static const bool enabled = !PerfLog::FolderExists("adaptive_keep_res");
+    return enabled;
+}
+
+constexpr float kAdaptiveLowResolution = 0.5f;
+
+struct AdaptiveStep {
+    float resolution;
+    int fps;
+};
+
+struct AdaptiveLadder {
+    AdaptiveStep steps[4];
+    int count = 0;
+};
+
+// Quality ladder, best first. Measured on a Helio G25 / PowerVR GE8320: half resolution sustains 25 FPS where full
+// resolution sustains 20, while 75% saves almost nothing.
+AdaptiveLadder MakeAdaptiveLadder(float userRes, int userFps) {
+    AdaptiveLadder ladder;
+    ladder.steps[ladder.count++] = { userRes, userFps };
+    float low = std::min(userRes, kAdaptiveLowResolution);
+    float res = userRes;
+    if (AdaptiveChangesResolution() && low < userRes - 0.01f) {
+        res = low;
+        ladder.steps[ladder.count++] = { res, userFps };
+    }
+    if (userFps > 25) {
+        ladder.steps[ladder.count++] = { res, 25 };
+    }
+    if (userFps > 20) {
+        ladder.steps[ladder.count++] = { res, 20 };
+    }
+    return ladder;
+}
 } // namespace
 
