+    int level = std::min(sAdaptiveLevel.load(), ladder.count - 1);
+    float wanted = ladder.steps[level].resolution;
+    // when the user moves the slider the menu has just applied the user's value: apply ours again
+    bool userChanged = std::fabs(userRes - lastUser) > 0.001f;
