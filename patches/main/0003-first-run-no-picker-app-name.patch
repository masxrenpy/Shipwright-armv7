+    // Android 6-10: the runtime permission answer arrives here. Without this the first launch never finished
+    // its setup (the native side waits forever) until the app was closed and opened again.
+    @Override
+    public void onRequestPermissionsResult(int requestCode, String[] permissions, int[] grantResults) {
+        super.onRequestPermissionsResult(requestCode, permissions, grantResults);
+        if (requestCode == STORAGE_PERMISSION_REQUEST_CODE) {
+            if (hasStoragePermission()) {
+                doVersionCheck();
+                checkAndSetupFiles();
+            } else {
+                Toast.makeText(this, "Storage permission is required to access files.", Toast.LENGTH_LONG).show();
+            }
+        }
+    }
