+#ifdef __ANDROID__
+// Best-effort native crash log: the engine's own crash handler is disabled on Android.
+#include <dlfcn.h>
+#include <fcntl.h>
+#include <signal.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <unwind.h>
+
+namespace {
+struct AndroidBacktraceState {
+    uintptr_t* current;
+    uintptr_t* end;
+};
+
+_Unwind_Reason_Code AndroidUnwindCallback(struct _Unwind_Context* ctx, void* arg) {
+    auto* state = static_cast<AndroidBacktraceState*>(arg);
+    uintptr_t pc = _Unwind_GetIP(ctx);
+    if (pc != 0) {
+        if (state->current == state->end) {
+            return _URC_END_OF_STACK;
+        }
+        *state->current++ = pc;
+    }
+    return _URC_NO_REASON;
+}
+
+void AndroidCrashSignalHandler(int sig, siginfo_t* info, void*) {
+    static volatile sig_atomic_t handling = 0;
+    if (handling) {
+        _exit(1);
+    }
+    handling = 1;
+    mkdir("/storage/emulated/0/SOH", 0777);
+    mkdir("/storage/emulated/0/SOH/logs", 0777);
+    int fd = open("/storage/emulated/0/SOH/logs/native-crash.txt", O_WRONLY | O_CREAT | O_APPEND, 0644);
+    if (fd >= 0) {
+        char buf[512];
+        int n = snprintf(buf, sizeof(buf), "---- native crash: signal=%d code=%d fault_addr=%p\n", sig,
+                         info != nullptr ? info->si_code : -1, info != nullptr ? info->si_addr : nullptr);
+        if (n > 0) {
+            (void)!write(fd, buf, (size_t)n);
+        }
+        uintptr_t frames[64];
+        AndroidBacktraceState state = { frames, frames + 64 };
+        _Unwind_Backtrace(AndroidUnwindCallback, &state);
+        for (uintptr_t* p = frames; p < state.current; ++p) {
+            Dl_info di;
+            if (dladdr((void*)*p, &di) != 0 && di.dli_fname != nullptr) {
+                n = snprintf(buf, sizeof(buf), "  #%d pc=%p %s+0x%lx\n", (int)(p - frames), (void*)*p, di.dli_fname,
+                             (unsigned long)(*p - (uintptr_t)di.dli_fbase));
+            } else {
+                n = snprintf(buf, sizeof(buf), "  #%d pc=%p\n", (int)(p - frames), (void*)*p);
+            }
+            if (n > 0) {
+                (void)!write(fd, buf, (size_t)n);
+            }
+        }
+        close(fd);
+    }
+    signal(sig, SIG_DFL);
+    raise(sig);
+}
+
+struct AndroidCrashInstaller {
+    AndroidCrashInstaller() {
+        struct sigaction sa;
+        memset(&sa, 0, sizeof(sa));
+        sa.sa_sigaction = AndroidCrashSignalHandler;
+        sa.sa_flags = SA_SIGINFO | SA_RESETHAND;
+        sigemptyset(&sa.sa_mask);
+        const int signals[] = { SIGSEGV, SIGABRT, SIGBUS, SIGFPE, SIGILL };
+        for (int sig : signals) {
+            sigaction(sig, &sa, nullptr);
+        }
+    }
+};
+static AndroidCrashInstaller sAndroidCrashInstaller;
+} // namespace
+#endif
