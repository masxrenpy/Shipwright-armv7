+#ifdef __ANDROID__
+namespace {
+std::atomic<int> sAdaptiveCap{ 0 };
+std::atomic<uint32_t> sAdaptiveUserFps{ 20 };
+
+// Optional: create the folder SOH/adaptive_fps to keep the game at full speed on slow phones by lowering the
+// interpolated FPS automatically when the game logic falls below 20 ticks per second.
+bool AdaptiveEnabled() {
+    static const bool enabled = PerfLog::FolderExists("adaptive_fps");
+    return enabled;
+}
+} // namespace
+
+static uint32_t AdaptiveCap(uint32_t fps) {
+    if (!AdaptiveEnabled()) {
+        return fps;
+    }
+    sAdaptiveUserFps = fps;
+    int cap = sAdaptiveCap.load();
+    return (cap > 0 && (uint32_t)cap < fps) ? (uint32_t)cap : fps;
+}
+
+// Called once per game tick.
+static void AdaptiveFpsTick() {
+    if (!AdaptiveEnabled()) {
+        return;
+    }
+    using Clock = std::chrono::steady_clock;
+    static Clock::time_point firstTick;
+    static Clock::time_point holdUntil = Clock::now();
+    static int ticks = 0;
+    static int stable = 0;
+    static int backoffSeconds = 30; // grows after every reduction so the cap does not keep oscillating
+    Clock::time_point now = Clock::now();
+    if (ticks == 0) {
+        firstTick = now;
+    }
+    ticks++;
+    double span = std::chrono::duration<double>(now - firstTick).count();
+    if (span < 3.0) {
+        return;
+    }
+    // Exact tick rate of the last window (the game runs at 20 ticks per second at full speed).
+    double rate = (ticks - 1) / span;
+    ticks = 0;
+    int user = (int)sAdaptiveUserFps.load();
+    int cap = sAdaptiveCap.load();
+    if (cap <= 0) {
+        cap = user;
+    }
+    int newCap = cap;
+    if (rate < 19.4 && cap > 20) {
+        newCap = std::max(20, cap - 5);
+        stable = 0;
+        holdUntil = now + std::chrono::seconds(backoffSeconds);
+        backoffSeconds = std::min(backoffSeconds * 2, 300);
+    } else if (rate >= 19.85 && cap < user && now >= holdUntil) {
+        if (++stable >= 6) {
+            newCap = std::min(user, cap + 2);
+            stable = 0;
+        }
+    } else if (rate < 19.85) {
+        stable = 0;
+    }
+    if (newCap != cap) {
+        sAdaptiveCap = newCap;
+        PerfLog::WriteLine(fmt::format("[perf] adaptive_fps: ticks/s={:.2f} cap {} -> {} (user {})", rate, cap, newCap, user));
+    }
+}
+#else
+static uint32_t AdaptiveCap(uint32_t fps) {
+    return fps;
+}
+static void AdaptiveFpsTick() {}
+#endif
