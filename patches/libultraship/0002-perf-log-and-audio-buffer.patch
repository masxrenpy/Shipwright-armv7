@@ -1,5 +1,9 @@
 #include "ship/audio/SDLAudioPlayer.h"
 #include <spdlog/spdlog.h>
+#include <spdlog/fmt/fmt.h>
+#include <sys/stat.h>
+#include <string>
+#include "ship/PerfLog.h"
 
 namespace Ship {
 
@@ -45,6 +49,27 @@ bool SDLAudioPlayer::DoInit() {
 
     SPDLOG_INFO("SDL Audio initialized: {} channels, {} Hz", mNumChannels, this->GetSampleRate());
 
+#ifdef __ANDROID__
+    {
+        // Extra audio buffering for slow CPUs. Create one of these folders inside SOH to enable it:
+        // audio_buf_100 (about 100 ms), audio_buf_150 or audio_buf_200.
+        int32_t desired = 0;
+        if (PerfLog::FolderExists("audio_buf_200")) {
+            desired = 6400;
+        } else if (PerfLog::FolderExists("audio_buf_150")) {
+            desired = 4800;
+        } else if (PerfLog::FolderExists("audio_buf_100")) {
+            desired = 3200;
+        }
+        if (desired > 0) {
+            this->SetDesiredBuffered(desired);
+            mQueueCap = desired + 3600;
+        }
+        PerfLog::WriteLine(fmt::format("[perf] audio rate={} desired_buffered={} queue_cap={}", this->GetSampleRate(),
+                                       this->GetDesiredBuffered(), mQueueCap));
+    }
+#endif
+
     SDL_PauseAudioDevice(mDevice, 0);
     return true;
 }
@@ -54,7 +79,9 @@ int SDLAudioPlayer::Buffered() {
 }
 
 void SDLAudioPlayer::DoPlay(const uint8_t* buf, size_t len) {
-    if (Buffered() < 6000) {
+    int buffered = Buffered();
+    PerfLog::Audio(buffered);
+    if (buffered < mQueueCap) {
         // Don't fill the audio buffer too much in case this happens
         SDL_QueueAudio(mDevice, buf, len);
     }
