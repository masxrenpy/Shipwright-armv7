+#include <sys/stat.h>
+#include <spdlog/fmt/fmt.h>
+
+// --- Android / OpenGL ES helpers (armv7 beta) ---
+static void GfxFileLog(const std::string& s) {
+#ifdef __ANDROID__
+    mkdir("/storage/emulated/0/SOH/logs", 0777);
+    FILE* f = fopen("/storage/emulated/0/SOH/logs/gfx-diag.txt", "a");
+    if (f) {
+        fputs(s.c_str(), f);
+        fputc('\n', f);
+        fclose(f);
+    }
+#endif
+}
+#define GFX_LOG(...) GfxFileLog(fmt::format(__VA_ARGS__))
+
+static bool GfxFolderFlag(const char* name) {
+#ifdef __ANDROID__
+    std::error_code ec;
+    return std::filesystem::exists(std::string("/storage/emulated/0/SOH/") + name, ec);
+#else
+    return false;
+#endif
+}
+
+// PowerVR Rogue GPUs (for example the GE8320) drop the alpha computed through the combiner WRAP() macro (mod), which
+// makes parts of models disappear. On those GPUs WRAP() is replaced by an identity. Folder overrides inside SOH:
+// "gfx_nowrap" forces the identity on any GPU, "gfx_wrap" forces the original behaviour.
+static bool GfxUseIdentityWrap() {
+#ifdef USE_OPENGLES
+    static int cached = -1;
+    if (cached < 0) {
+        const char* renderer = (const char*)glGetString(GL_RENDERER);
+        bool powervr = renderer != nullptr && strstr(renderer, "PowerVR") != nullptr;
+        bool force = GfxFolderFlag("gfx_nowrap");
+        bool forbid = GfxFolderFlag("gfx_wrap");
+        cached = (force || (powervr && !forbid)) ? 1 : 0;
+        GFX_LOG("[gfx] renderer={} identity_wrap={}", renderer != nullptr ? renderer : "?", cached);
+    }
+    return cached == 1;
+#else
+    return false;
+#endif
+}
 
