+// Current CPU of the calling thread and the current frequency (MHz) of every core.
+inline std::string CpuInfo() {
+#ifdef __ANDROID__
+    std::string out = fmt::format("cpu={} freq_mhz=", sched_getcpu());
+    long ncpu = sysconf(_SC_NPROCESSORS_CONF);
+    if (ncpu > 16) {
+        ncpu = 16;
+    }
+    for (long i = 0; i < ncpu; i++) {
+        std::string path = fmt::format("/sys/devices/system/cpu/cpu{}/cpufreq/scaling_cur_freq", i);
+        long khz = -1;
+        FILE* f = fopen(path.c_str(), "r");
+        if (f != nullptr) {
+            if (fscanf(f, "%ld", &khz) != 1) {
+                khz = -1;
+            }
+            fclose(f);
+        }
+        out += fmt::format("{}{}", i > 0 ? "," : "", khz > 0 ? khz / 1000 : -1);
+    }
+    return out;
+#else
+    return std::string();
+#endif
+}
+
+// Pins the calling thread to the cores with the highest maximum frequency.
+inline void PinToFastestCores() {
+#ifdef __ANDROID__
+    long ncpu = sysconf(_SC_NPROCESSORS_CONF);
+    if (ncpu > 16) {
+        ncpu = 16;
+    }
+    long maxFreq[16] = { 0 };
+    long best = 0;
+    for (long i = 0; i < ncpu; i++) {
+        std::string path = fmt::format("/sys/devices/system/cpu/cpu{}/cpufreq/cpuinfo_max_freq", i);
+        FILE* f = fopen(path.c_str(), "r");
+        if (f != nullptr) {
+            if (fscanf(f, "%ld", &maxFreq[i]) != 1) {
+                maxFreq[i] = 0;
+            }
+            fclose(f);
+        }
+        if (maxFreq[i] > best) {
+            best = maxFreq[i];
+        }
+    }
+    if (best == 0) {
+        WriteLine("[perf] cpu_big: could not read the core frequencies");
+        return;
+    }
+    cpu_set_t set;
+    CPU_ZERO(&set);
+    std::string cores;
+    for (long i = 0; i < ncpu; i++) {
+        if (maxFreq[i] == best) {
+            CPU_SET((int)i, &set);
+            cores += fmt::format("{}{}", cores.empty() ? "" : ",", i);
+        }
+    }
+    int rc = sched_setaffinity(0, sizeof(set), &set);
+    WriteLine(fmt::format("[perf] cpu_big: max_freq_khz={} cores={} rc={}", best, cores, rc));
+#endif
+}
