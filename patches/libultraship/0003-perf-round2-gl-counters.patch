+// One game tick (20 per second at full speed): start of the tick, after the frame interpolation setup, after all the
+// frames of the tick were rendered, after waiting for the audio thread.
+inline void Tick(Clock::time_point start, Clock::time_point interpEnd, Clock::time_point renderEnd,
+                 Clock::time_point audioEnd) {
+    if (!Enabled()) {
+        return;
+    }
+    State& s = S();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    double interp = Ms(start, interpEnd);
+    double render = Ms(interpEnd, renderEnd);
+    double audioWait = Ms(renderEnd, audioEnd);
+    if (s.haveLastTick) {
+        double gap = Ms(s.lastTick, start);
+        s.tickGap.Add(gap);
+        double logic = gap - (interp + render + audioWait);
+        s.logic.Add(logic > 0 ? logic : 0);
+    }
+    s.lastTick = start;
+    s.haveLastTick = true;
+    s.interp.Add(interp);
+    s.render.Add(render);
+    s.audioWait.Add(audioWait);
+    s.ticks++;
+}
+
