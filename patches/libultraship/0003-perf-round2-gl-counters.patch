+class ScopedTimer {
+  public:
+    ScopedTimer(Kind kind, uint64_t arg = 0) : mKind(kind), mArg(arg), mOn(Enabled()) {
+        if (mOn) {
+            mStart = Clock::now();
+        }
+    }
+    ~ScopedTimer() {
+        if (!mOn) {
+            return;
+        }
+        uint64_t ns = (uint64_t)std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now() - mStart).count();
+        Counters& c = C();
+        switch (mKind) {
+            case Kind::Draw:
+                c.draws++;
+                c.drawTris += mArg;
+                c.drawNs += ns;
+                break;
+            case Kind::Upload:
+                c.uploads++;
+                c.uploadNs += ns;
+                break;
+            case Kind::Compile: {
+                c.compiles++;
+                c.compileNs += ns;
+                uint64_t prev = c.compileMaxNs.load();
+                while (ns > prev && !c.compileMaxNs.compare_exchange_weak(prev, ns)) {
+                }
+                break;
+            }
+        }
+    }
+
+  private:
+    Kind mKind;
+    uint64_t mArg;
+    bool mOn;
+    Clock::time_point mStart;
+};
