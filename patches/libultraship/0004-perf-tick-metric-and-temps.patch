+// Reads the first number of a small text file (-1 when it cannot be read).
+inline long ReadNumber(const std::string& path) {
+    long value = -1;
+    FILE* f = fopen(path.c_str(), "r");
+    if (f != nullptr) {
+        if (fscanf(f, "%ld", &value) != 1) {
+            value = -1;
+        }
+        fclose(f);
+    }
+    return value;
+}
+
+// Battery and thermal-zone temperatures (degrees C) and the clock (MHz) of devices that expose it, when readable.
+inline std::string ThermalInfo() {
+#ifdef __ANDROID__
+    std::string out = "temps_c=";
+    long battery = ReadNumber("/sys/class/power_supply/battery/temp"); // tenths of a degree
+    out += fmt::format("bat:{}", battery >= 0 ? fmt::format("{:.1f}", battery / 10.0) : std::string("n/a"));
+    for (int i = 0; i < 12; i++) {
+        long milli = ReadNumber(fmt::format("/sys/class/thermal/thermal_zone{}/temp", i));
+        if (milli > 0) {
+            out += fmt::format(",tz{}:{:.0f}", i, milli > 1000 ? milli / 1000.0 : (double)milli);
+        }
+    }
+    std::string devfreq;
+    DIR* dir = opendir("/sys/class/devfreq");
+    if (dir != nullptr) {
+        while (struct dirent* entry = readdir(dir)) {
+            if (entry->d_name[0] == '.') {
+                continue;
+            }
+            long hz = ReadNumber(fmt::format("/sys/class/devfreq/{}/cur_freq", entry->d_name));
+            if (hz > 0) {
+                devfreq += fmt::format("{}{}:{}", devfreq.empty() ? "" : ",", entry->d_name, hz / 1000000);
+            }
+        }
+        closedir(dir);
+    }
+    return out + " devfreq_mhz=" + (devfreq.empty() ? std::string("n/a") : devfreq);
+#else
+    return std::string();
+#endif
+}
